---
import { pageDate, dateLongue } from '../lib/page-date';
interface Props {
  title: string;
  description?: string;
}

const { title, description = 'Free immigration points calculators for Canada Express Entry CRS and Australia SkillSelect. Calculate your score instantly.' } = Astro.props;
const currentYear = new Date().getFullYear();
// Date de mise à jour en bas de chaque page, en toutes lettres (RECETTE §8.4).
const updated = pageDate(Astro.url.pathname);

const rawCanonical = new URL(Astro.url.pathname, 'https://immigrationpoints.com').href;
const canonicalURL = rawCanonical.endsWith('/') ? rawCanonical : `${rawCanonical}/`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Immigration Points Calculator" />
    <meta name="author" content="Radif Partners" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- favicon.ico et apple-touch-icon : le robot des favicons de Google les demande a la racine (RECETTE §13). -->
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Immigration Points Calculator",
      "url": "https://immigrationpoints.com",
      "logo": "https://immigrationpoints.com/favicon.svg",
      "founder": {
        "@type": "Organization",
        "name": "Radif Partners"
      }
    })} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "Radif Partners",
      "jobTitle": "Financial Technology Expert",
      "url": "https://immigrationpoints.com"
    })} />

    {/* Google Analytics 4, régime « sans bandeau » (décision de l'éditeur du 2026-10-17) : cookies _ga et
         _ga_<ID> de 13 mois au plus non prolongés, publicité refusée, IP anonymisée, adresse de page sans
         paramètres. Décrit dans /privacy/. */}
    <script is:inline set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}window.gtag=gtag;gtag('consent','default',{analytics_storage:'granted',ad_storage:'denied',ad_user_data:'denied',ad_personalization:'denied',functionality_storage:'granted',security_storage:'granted'});`} />
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-43BP26Y79R"></script>
    <script is:inline set:html={`gtag('js',new Date());gtag('config','G-43BP26Y79R',{anonymize_ip:true,page_location:location.origin+location.pathname,cookie_expires:33696000,cookie_update:false,allow_google_signals:false,allow_ad_personalization_signals:false});`} />

    <script is:inline set:html={`(function(){window.clarity=window.clarity||function(){(window.clarity.q=window.clarity.q||[]).push(arguments);};window.clarity('consentv2',{ad_Storage:'denied',analytics_Storage:'denied'});var s=document.createElement('script');s.async=true;s.src='https://www.clarity.ms/tag/yx9u4uhobk';document.head.appendChild(s);})();`} />
  </head>
  <body data-clarity-mask="true" class="min-h-screen flex flex-col">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-white focus:text-blue-700 focus:rounded-lg focus:shadow-lg focus:ring-2 focus:ring-blue-500">Skip to content</a>
    <!-- Header -->
    <header class="bg-primary text-white shadow-md">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold hover:opacity-90 transition-opacity">
          ImmigrationPoints.com
        </a>

        <!-- Desktop Navigation -->
        <div class="hidden md:flex items-center gap-6 text-sm">
          <a href="/canada/" class="hover:underline underline-offset-4">Canada CRS</a>
          <a href="/australia/" class="hover:underline underline-offset-4">Australia Points</a>
          <a href="/guides/" class="hover:underline underline-offset-4">Guides</a>
          <a href="/faq/" class="hover:underline underline-offset-4">FAQ</a>
        </div>

        <!-- Mobile Hamburger Button -->
        <button
          id="mobile-menu-btn"
          type="button"
          class="md:hidden relative w-8 h-8 flex flex-col items-center justify-center gap-1.5"
          aria-label="Toggle navigation menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <span class="hamburger-line block w-6 h-0.5 bg-white rounded transition-all duration-300 origin-center"></span>
          <span class="hamburger-line block w-6 h-0.5 bg-white rounded transition-all duration-300 origin-center"></span>
          <span class="hamburger-line block w-6 h-0.5 bg-white rounded transition-all duration-300 origin-center"></span>
        </button>
      </nav>

      <!-- Mobile Navigation Panel -->
      <div
        id="mobile-menu"
        class="mobile-menu md:hidden overflow-hidden max-h-0 transition-all duration-300 ease-in-out"
      >
        <div class="px-4 pb-4 flex flex-col gap-3 text-sm border-t border-white/20 pt-4">
          <a href="/canada/" class="hover:underline underline-offset-4 py-1">Canada CRS</a>
          <a href="/australia/" class="hover:underline underline-offset-4 py-1">Australia Points</a>
          <a href="/guides/" class="hover:underline underline-offset-4 py-1">Guides</a>
          <a href="/faq/" class="hover:underline underline-offset-4 py-1">FAQ</a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main id="main-content" class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-neutral-800 text-neutral-300 mt-12">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-8">
          <div>
            <h3 class="text-white font-semibold mb-3">Calculators</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/canada/" class="hover:text-white transition-colors">Canada Express Entry CRS</a></li>
              <li><a href="/australia/" class="hover:text-white transition-colors">Australia SkillSelect Points</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-white font-semibold mb-3">Resources</h3>
            <ul class="space-y-2 text-sm">
              <li><a href="/guides/" class="hover:text-white transition-colors">Immigration Guides</a></li>
              <li><a href="/faq/" class="hover:text-white transition-colors">Frequently Asked Questions</a></li>
              <li><a href="/legal/" class="hover:text-white transition-colors">Legal Disclaimer</a></li>
              <li><a href="/privacy/" class="hover:text-white transition-colors">Privacy Policy</a></li>
            </ul>
          </div>
          <div>
            <h3 class="text-white font-semibold mb-3">About</h3>
            <p class="text-sm">
              ImmigrationPoints.com provides free, open-source immigration points calculators
              for prospective migrants to Canada and Australia. Our calculators are for informational
              purposes only and do not constitute legal advice.
            </p>
          </div>
        </div>
        <div class="border-t border-neutral-700 pt-6 text-center text-sm">
          <p>&copy; {currentYear} ImmigrationPoints.com. All rights reserved. Not affiliated with any government agency.</p>
          {updated && <p class="mt-2">Last updated <time datetime={updated}>{dateLongue(updated)}</time></p>}
        </div>
      </div>
    </footer>

    <!-- Mobile menu toggle script -->
    <script is:inline>
      (function() {
        var btn = document.getElementById('mobile-menu-btn');
        var menu = document.getElementById('mobile-menu');
        if (!btn || !menu) return;

        btn.addEventListener('click', function() {
          var expanded = btn.getAttribute('aria-expanded') === 'true';
          btn.setAttribute('aria-expanded', String(!expanded));
          btn.classList.toggle('menu-open');

          if (!expanded) {
            menu.style.maxHeight = menu.scrollHeight + 'px';
          } else {
            menu.style.maxHeight = '0';
          }
        });
      })();
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';

  /* Hamburger to X animation */
  .menu-open .hamburger-line:nth-child(1) {
    transform: translateY(0.5rem) rotate(45deg);
  }
  .menu-open .hamburger-line:nth-child(2) {
    opacity: 0;
    transform: scaleX(0);
  }
  .menu-open .hamburger-line:nth-child(3) {
    transform: translateY(-0.5rem) rotate(-45deg);
  }
</style>
