            <tr><td class="border border-neutral-200 px-4 py-2">Nova Scotia</td><td class="border border-neutral-200 px-4 py-2">Yes</td><td class="border border-neutral-200 px-4 py-2">Labour market priorities</td></tr>
            <tr><td class="border border-neutral-200 px-4 py-2">New Brunswick</td><td class="border border-neutral-200 px-4 py-2">Yes</td><td class="border border-neutral-200 px-4 py-2">Labour market, Francophone</td></tr>
            <tr><td class="border border-neutral-200 px-4 py-2">PEI</td><td class="border border-neutral-200 px-4 py-2">Yes</td><td class="border border-neutral-200 px-4 py-2">Provincial connections</td></tr>
            <tr><td class="border border-neutral-200 px-4 py-2">Newfoundland</td><td class="border border-neutral-200 px-4 py-2">Yes</td><td class="border border-neutral-200 px-4 py-2">Job offers from provincial employers</td></tr>
            <tr><td class="border border-neutral-200 px-4 py-2">Yukon</td><td class="border border-neutral-200 px-4 py-2">Yes</td><td class="border border-neutral-200 px-4 py-2">Employer-driven</td></tr>
