          <tbody>
            <tr><td class="border border-neutral-200 px-4 py-2">Ontario</td><td class="border border-neutral-200 px-4 py-2">Yes</td><td class="border border-neutral-200 px-4 py-2">Human capital, tech, French speakers</td></tr>
            <tr><td class="border border-neutral-200 px-4 py-2">British Columbia</td><td class="border border-neutral-200 px-4 py-2">Yes</td><td class="border border-neutral-200 px-4 py-2">Tech, healthcare, skilled workers</td></tr>
            <tr><td class="border border-neutral-200 px-4 py-2">Alberta</td><td class="border border-neutral-200 px-4 py-2">Yes</td><td class="border border-neutral-200 px-4 py-2">In-demand occupations, Alberta ties</td></tr>
